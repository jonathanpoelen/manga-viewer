#!/usr/bin/env bash

set -e

# Checks whether a command `htmlviewer is available
# or searches for the program in the same folder as `htmlviewer-gui`.
cmd=htmlviewer
if ! command -v "$cmd" &>/dev/null; then
  cmd="$(basename "$0")"/htmlviewer
  if [[ ! -f "$cmd" ]]; then
    zenity --error --text 'htmlviewer not found'
    exit 1
  fi
fi

ifs="$IFS"
IFS=$'\n'
files=($(zenity --title='Select directories' --file-selection --directory --multiple --separator=$'\n')) || exit 1
IFS="$ifs"

mode=$(zenity --title='Select mode' --list --column='' --text='Default mode' --hide-header normal 'double page' 'normal or double page' webtoon all) || exit 1
[[ $mode != 'double page' ]] || mode=double
[[ $mode != 'normal or double page' ]] || mode=normal_or_double

output=${TMPDIR:-/tmp}/htmlviewer.html

"$cmd" -m $mode -- "${files[@]}" > "$output"
xdg-open "$output"
